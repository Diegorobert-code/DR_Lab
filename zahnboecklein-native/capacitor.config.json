{
  "appId": "ch.zahnboecklein.app",
  "appName": "Zahnböcklein",
  "webDir": "www",
  "backgroundColor": "#1b1f4b",
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#1b1f4b",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "NativePurchases": {
      "autoFinishTransactions": true
    }
  }
}
